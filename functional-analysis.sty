\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{functional-analysis}[2026/10/09 Distribution theory book profile]
\RequirePackage{longtable}
% Windows 宋体没有独立斜体字形，书稿的强调文字采用楷体。
\ifdefstring{\MakiResolvedFontPreset}{windows}{%
  \IfFontExistsTF{KaiTi}{%
    \setCJKmainfont{SimSun}[AutoFakeBold=3,ItalicFont=KaiTi,BoldItalicFont=KaiTi]%
  }{}%
}{}
% 本书专用扩展层：保留原始 maki-notes.cls 与 maki-notes.sty。
\tcbset{commonbox/.append style={breakable,
  fontupper=\linespread{1.32}\selectfont,
  left=5mm,right=5mm,top=3mm,bottom=3mm,
  before skip=1.2em,after skip=1em}}
% 模板的工作流卡片使用与标题条相同的标题文字颜色，印刷时不可见。
% 在本书中统一改为白字，并显式填充标题条。
\tcbset{
  maki method box/.append style={coltitle=white,title filled=true},
  maki pitfall box/.append style={coltitle=white,title filled=true},
  maki remark box/.append style={coltitle=white,title filled=true},
  maki keyformula box/.append style={coltitle=white,title filled=true},
  maki solution box/.append style={coltitle=white,title filled=true}}
\renewcommand{\MakiHeaderLeftText}{泛函分析}
\renewcommand{\MakiHeaderRightText}{\nouppercase{\leftmark}}
\setcounter{tocdepth}{2}
\setcounter{secnumdepth}{2}
\setlength{\emergencystretch}{2em}
% 本书所有教学插图及共用 TikZ 样式统一维护于 figures/。
\input{figures/tikz-styles.tex}
\renewcommand{\thefigure}{\thechapter.\arabic{figure}}
\allowdisplaybreaks[2]
% 模板在标题局部分组中 refstepcounter，正文 label 会回退到节号。
% 在环境入口推进共享计数器，标题只读取编号，使引用与显示一致。
\renewenvironment{theorem}[1][]{\refstepcounter{theorem}\begin{thmBox}[before title={}]{定理}{#1}}{\end{thmBox}}
\renewenvironment{lemma}[1][]{\refstepcounter{theorem}\begin{thmBox}[before title={}]{引理}{#1}}{\end{thmBox}}
\renewenvironment{proposition}[1][]{\refstepcounter{theorem}\begin{thmBox}[before title={}]{命题}{#1}}{\end{thmBox}}
\renewenvironment{corollary}[1][]{\refstepcounter{theorem}\begin{thmBox}[before title={}]{推论}{#1}}{\end{thmBox}}
\renewenvironment{property}[1][]{\refstepcounter{theorem}\begin{thmBox}[before title={}]{性质}{#1}}{\end{thmBox}}
\renewenvironment{definition}[1][]{\refstepcounter{theorem}\begin{defBox}[before title={}]{定义}{#1}}{\end{defBox}}
\renewenvironment{axiom}[1][]{\refstepcounter{theorem}\begin{defBox}[before title={}]{公理}{#1}}{\end{defBox}}
\renewenvironment{example}[1][]{\refstepcounter{theorem}\begin{exBox}[before title={}]{例题}{#1}}{\end{exBox}}
\renewenvironment{longexample}[1][]{\refstepcounter{theorem}\begin{longexBox}[before title={}]{例题}{#1}}{\end{longexBox}}
\renewenvironment{exercise}[1][]{\refstepcounter{theorem}\begin{exBox}[before title={}]{练习}{#1}\xdef\MakiCurrentExerciseNumber{\thetheorem}}{\end{exBox}}
